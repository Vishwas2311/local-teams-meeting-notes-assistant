APP_ENV=development

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_TIMEOUT_SECONDS=60
AZURE_MAX_RETRIES=4
AZURE_SUMMARY_TOKEN_BUDGET=6000

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=auto
WHISPER_MODEL_CACHE=./models

SYSTEM_AUDIO_DEVICE=
MICROPHONE_DEVICE=
CAPTURE_MICROPHONE=true
AUDIO_CHUNK_SECONDS=20
AUDIO_QUEUE_SIZE=12
CAPTURE_SAMPLE_RATE=48000
ENABLE_VAD=true
KEEP_RAW_AUDIO=false

ENABLE_PERIODIC_SUMMARY=false
SUMMARY_INTERVAL_MINUTES=15
DATA_DIRECTORY=./data
LOG_LEVEL=INFO

